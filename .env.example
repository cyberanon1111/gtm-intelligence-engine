# PostgreSQL connection string (hosted Postgres — e.g. Neon or Supabase — or local).
# Use the direct (non-pooled) connection for migrations and local dev.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Optional: pooled connection string, recommended for serverless runtime (Vercel).
DATABASE_URL_POOLED="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# Claude API key for the Research, GTM Intelligence, and Activation agents.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Which external ResearchProvider to use for source retrieval (lib/research-provider/factory.ts).
# "unconfigured" (default) — research still works, but external retrieval is
#   skipped with a clear error recorded on the ResearchRun; the AI research/
#   why-now steps still run on whatever signals already exist.
# "tavily" — requires TAVILY_API_KEY below.
RESEARCH_PROVIDER="unconfigured"

# Tavily (https://tavily.com) API key, only used when RESEARCH_PROVIDER=tavily.
TAVILY_API_KEY=""
